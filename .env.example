# ============================================================================
# AuditPilot environment configuration
# Copy to `.env` and fill in real values:  cp .env.example .env
# ============================================================================

# ---- OpenAI ----
OPENAI_API_KEY=

# ---- LangSmith tracing ----
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=auditpilot
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ---- Redis (Celery broker + result backend) ----
# When running via docker-compose use the service name `redis` as host:
#   REDIS_URL=redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ---- ChromaDB persistent store ----
CHROMA_PERSIST_DIR=./chroma_db

# ---- SEC EDGAR (a descriptive User-Agent is REQUIRED by the SEC) ----
SEC_USER_AGENT=YourName your@email.com

# ---- Optional model overrides (defaults shown) ----
PLANNER_MODEL=gpt-4o
RISK_MODEL=gpt-4o
CRITIC_MODEL=gpt-4o-mini
MEMO_MODEL=gpt-4o
EMBED_MODEL=text-embedding-3-small

# ---- Frontend -> backend base URL (used by Streamlit) ----
BACKEND_URL=http://localhost:8000
